{
  "name": "craftdock",
  "productName": "CraftDock",
  "version": "1.3.1",
  "description": "Organizzatore e launcher di server Minecraft locali per Windows, con tunnel senza port forwarding, mod, backup e pannello opzioni.",
  "author": "numbfede",
  "license": "MIT",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "test": "node test/run.js",
    "dist": "electron-builder --win nsis portable",
    "dist:dir": "electron-builder --win dir",
    "dist:mac": "electron-builder --mac dmg zip --arm64 --x64"
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "pidusage": "^4.0.1",
    "yauzl": "^3.2.0"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.numbfede.craftdock",
    "productName": "CraftDock",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ],
      "legalTrademarks": "CraftDock"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "CraftDock",
      "artifactName": "CraftDock-Setup.exe",
      "uninstallDisplayName": "CraftDock"
    },
    "portable": {
      "artifactName": "CraftDock-Portable.exe"
    },
    "publish": null,
    "copyright": "Copyright © 2026 numbfede",
    "mac": {
      "category": "public.app-category.games",
      "icon": "build/icon-mac.png",
      "artifactName": "CraftDock-mac-${arch}.${ext}",
      "darkModeSupport": true,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "minimumSystemVersion": "11.0",
      "identity": null,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "dmg": {
      "title": "CraftDock",
      "background": "build/dmg-background.png",
      "iconSize": 96,
      "window": {
        "width": 540,
        "height": 400
      },
      "contents": [
        {
          "x": 150,
          "y": 200,
          "type": "file"
        },
        {
          "x": 390,
          "y": 200,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "artifactName": "CraftDock-mac-${arch}.${ext}",
      "writeUpdateInfo": false
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/numbfede/CraftDock.git"
  },
  "homepage": "https://craftdock.numbfede.com"
}
